---
import { SEO } from "astro-seo";
import TopNav from "../components/TopNav.astro";
import { UIPortalInpageNav } from "../components/ui-portal-inpage-nav.js";
import ThemeInit from '../components/ThemeInit.astro';
import LionWordmark from '../components/LionWordmark.astro';

const site = Astro.site || Astro.url.origin;
const canonicalURL = new URL(Astro.url.pathname, site).toString();
const resolvedImageWithDomain = new URL("/opengraph.jpg", site).toString();

interface SidebarItem {
  href: string;
  label: string;
}

interface Heading {
  name: string;
  url: string;
}

interface Props {
  title: string;
  activeNavItem: string; // e.g., "components", "guides"
  sectionName: string; // e.g., "Components", "Guides"
  itemName?: string; // e.g., "button", "getting-started" for sidebar highlighting
  description?: string;
  backLink?: string;
  backLinkLabel?: string;
  items?: SidebarItem[];
  itemsByCategory?: Map<string, SidebarItem[]>;
  headings?: Heading[];
}

const {
  title,
  activeNavItem,
  sectionName,
  itemName,
  description = "Accessible component with various states and styles.",
  backLink = `${import.meta.env.BASE_URL}/${activeNavItem}/`,
  backLinkLabel = `← Back to ${sectionName}`,
  items = [],
  itemsByCategory = new Map(),
  headings = [],
} = Astro.props;

const currentPath = Astro.url.pathname;

/*
 * Breadcrumb: the ancestors of this page, section first. The docs titles used to carry their parent
 * as a prefix ("Principles: Definitions and Terms"), which is what this trail replaces - the parent
 * is one crumb up instead of being repeated in the heading ("Guides" then "Principles" for
 * /guides/principles/definitions-and-terms, and it goes as deep as the page: /fundamentals/systems/
 * core/overview shows Fundamentals, Systems, Core).
 *
 * Labels come from the url segments, so they follow the folder names the sidebar uses.
 */
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const relativePath = currentPath.startsWith(basePath) ? currentPath.slice(basePath.length) : currentPath;
const pathSegments = relativePath.split('/').filter(Boolean);
const breadcrumbSegments = pathSegments.slice(1, -1); // drop the section and the page itself
const humanise = segment =>
  decodeURIComponent(segment)
    .replace(/[-_]/g, ' ')
    .replace(/\b\w/g, char => char.toUpperCase());

const breadcrumbTrail = breadcrumbSegments.map((segment, index) => ({
  label: humanise(segment),
  url: `${import.meta.env.BASE_URL}/${pathSegments[0]}/${breadcrumbSegments.slice(0, index + 1).join('/')}`,
}));

// If items are provided but not categorized, put them all in the first category
let componentsByCategory = itemsByCategory;
if (items.length > 0 && componentsByCategory.size === 0) {
  componentsByCategory = new Map();
  componentsByCategory.set(sectionName.toLowerCase(), items);
}
---

<style>
  .docs-sidebar {
    width: 240px;
    padding-right: 1rem;
    border-right: 1px solid rgba(255, 255, 255, 0.1);
    position: sticky;
    top: 6rem;
    height: 100vh;
    overflow-y: auto;

  }

  /*
   * Breadcrumb: small and muted, with the page title below it doing the announcing. The separator is
   * drawn rather than typed, so it does not read as part of either label.
   */
  .docs-breadcrumb {
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
  }

  .docs-breadcrumb ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
  }

  .docs-breadcrumb li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .docs-breadcrumb li:not(:first-child)::before {
    content: '/';
    color: var(--border-color);
  }

  .docs-breadcrumb a {
    color: inherit;
    text-decoration: none;
  }

  .docs-breadcrumb a:hover,
  .docs-breadcrumb a:focus-visible {
    color: var(--accent-on-surface);
    text-decoration: underline;
    text-decoration-color: var(--accent-yellow);
    text-underline-offset: 3px;
  }

  .component-nav h3 {
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin: 1rem 0 0.75rem 0;
    padding: 0 1rem;
  }

  .component-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .category-item {
    display: block;
  }

  .category-toggle {
    display: block;
    width: 100%;
    padding: 0.5rem 1rem;
    background: none;
    border: none;
    /* Hard-coded #888 was the dark value: 3.54:1 on white. */
    color: var(--text-secondary);
    font-size: 0.75rem;
    font-weight: 600;
    text-align: left;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 0.2s ease;
    position: relative;
    padding-left: 1.5rem;
  }

  .category-toggle:before {
    content: '▼';
    position: absolute;
    left: 0.5rem;
    font-size: 0.6rem;
    transition: transform 0.2s ease;
  }

  .category-toggle[aria-expanded="false"]:before {
    transform: rotate(-90deg);
  }

  .category-toggle:hover {
    /* #333 was the light value: 1.9:1 on the dark background. */
    color: var(--text-primary);
  }

  .category-submenu {
    list-style: none;
    margin: 0;
    padding: 0;
    transition: max-height 0.3s ease, opacity 0.3s ease;
    max-height: 1000px;
    opacity: 1;
    overflow: hidden;
  }

  .category-submenu.collapsed {
    max-height: 0;
    opacity: 0;
  }

  .component-item {
    display: block;
  }

  .component-link {
    display: block;
    padding: 0.5rem 1rem;
    color: var(--text-primary);
    text-decoration: none;
    font-size: 0.875rem;
    border-left: 3px solid transparent;
    transition: all 0.2s ease;
    margin-left: 0.5rem;
  }

  .component-link:hover {
    background-color: color-mix(in srgb, var(--accent-yellow) 5%, transparent);
    color: var(--accent-on-surface);
  }

  .component-link.active {
    color: var(--accent-on-surface);
    background-color: color-mix(in srgb, var(--accent-yellow) 10%, transparent);
    border-left-color: var(--accent-yellow);
    font-weight: 500;
  }

  .docs-layout {
    display: grid;
    grid-template-columns: 240px 1fr 280px;
    gap: 4rem;
    align-items: start;
  }

  .docs-content {
    grid-column: 2;
  }

  .docs-toc {
    grid-column: 3;
    position: sticky;
    top: 20px;
    height: fit-content;
    max-height: calc(100vh - 40px);
    overflow-y: auto;
  }

  .logo-text-svg {
    filter: grayscale(100%) contrast(12) brightness(0.25);
  }

  @media (max-width: 1200px) {
    .docs-layout {
      grid-template-columns: 0 1fr;
      gap: 0;
    }

    .docs-sidebar {
      display: none;
    }
    .docs-toc {
      display: none;
    }
  }
</style>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="view-transition" content="same-origin" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light dark" />
    <ThemeInit />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href=`${import.meta.env.BASE_URL}/favicon.svg` />
    <meta name="generator" content={Astro.generator} />
    
    <link rel="stylesheet" href={`${import.meta.env.BASE_URL}/styles/theme.css`} />
    <link rel="stylesheet" href=`${import.meta.env.BASE_URL}/styles/styles.css`>
    <link rel="stylesheet" href=`${import.meta.env.BASE_URL}/styles/components.css`>
    <link rel="stylesheet" href=`${import.meta.env.BASE_URL}/styles/transitions.css`>
    <link rel="stylesheet" href=`${import.meta.env.BASE_URL}/styles/scroll-animations.css`>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

    <script src="@webcomponents/scoped-custom-element-registry/scoped-custom-element-registry.min.js"></script>

    <SEO
      title={title}
      description={description}
      canonical={canonicalURL}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: "website",
          title: title,
          image: resolvedImageWithDomain,
        },
        image: {
          alt: `${title}`,
        },
      }}
    />
    <script src="../components/demo-viewer/oj-viewer.js"></script>
</head>
<body>
    <div class="scroll-progress"></div>
    <div class="grid-background"></div>
    
    <TopNav activeNavItem={activeNavItem} />

    <main>
        <div class="container">
            <div class="docs-layout">
                <aside class="docs-sidebar">
                    <a href={backLink} class="back-link">{backLinkLabel}</a>
                    <nav class="component-nav">
                        <h3>{sectionName}</h3>
                        <ul>
                            {Array.from(componentsByCategory.entries()).map(([category, categoryItems]) => {
                                const hasActiveItem = categoryItems.some(item => 
                                  currentPath.replace(/\/$/, '').toLowerCase().endsWith(item.href.replace(/\/$/, '').toLowerCase())
                                );
                                return (
                                <>
                                    <li class="category-item">
                                        <button class="category-toggle" data-category={category} aria-expanded={hasActiveItem ? "true" : "false"}>
                                            {category.charAt(0).toUpperCase() + category.slice(1)}
                                        </button>
                                    </li>
                                    <ul class="category-submenu" data-category={category}>
                                        {categoryItems.map((item) => {
                                            const isActive = currentPath.replace(/\/$/, '').toLowerCase().endsWith(item.href.replace(/\/$/, '').toLowerCase());
                                            return (
                                                <li class="component-item">
                                                    <a href={`${import.meta.env.BASE_URL}${item.href.replace(/\/$/, '')}`} class={`component-link ${isActive ? 'active' : ''}`} data-category={category} aria-current={isActive ? "page" : undefined}>
                                                        {item.label}
                                                    </a>
                                                </li>
                                            );
                                        })}
                                    </ul>
                                </>
                                );
                            })}
                        </ul>
                    </nav>
                </aside>

                <div class="docs-content" data-pagefind-body>
                    {breadcrumbTrail.length > 0 && (
                        <nav class="docs-breadcrumb" aria-label="Breadcrumb">
                            <ol>
                                <li><a href={backLink}>{sectionName}</a></li>
                                {breadcrumbTrail.map(crumb => (
                                    <li><a href={crumb.url}>{crumb.label}</a></li>
                                ))}
                            </ol>
                        </nav>
                    )}
                    <slot />
                </div>

                <aside class="docs-toc">
                    <UIPortalInpageNav navData={headings} client:load />
                </aside>
            </div>
        </div>
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="footer-row">
                <div class="footer-brand">
                    <LionWordmark />
                    <p class="copyright">&copy; {new Date().getFullYear()} Lion Project. MIT License.</p>
                </div>
                <div class="footer-links">
                    <a href=`${import.meta.env.BASE_URL}/blog/`>Blog</a>
                    <a href="https://github.com/ing-bank/lion/issues">Help</a>
                    <a href="https://github.com/ing-bank/lion">GitHub</a>
                    <a href=`${import.meta.env.BASE_URL}/about/slack/`>Slack</a>
                    <a href="https://github.com/ing-bank/lion/blob/master/CONTRIBUTING.md">Contribute</a>
                </div>
            </div>
        </div>
    </footer>
</body>

<script>
  // Handle category toggle interactions and persistence
  document.querySelectorAll('.category-toggle').forEach(toggle => {
    const category = toggle.getAttribute('data-category');
    const submenu = document.querySelector(`.category-submenu[data-category="${category}"]`);
    
    // Restore previous state from localStorage, or use current aria-expanded state
    const savedState = localStorage.getItem(`category-${category}`);
    if (savedState === 'collapsed') {
      toggle.setAttribute('aria-expanded', 'false');
      submenu?.classList.add('collapsed');
    } else if (savedState === 'expanded') {
      toggle.setAttribute('aria-expanded', 'true');
      submenu?.classList.remove('collapsed');
    } else {
      // Use the aria-expanded value set in the template (based on active items)
      if (toggle.getAttribute('aria-expanded') === 'false') {
        submenu?.classList.add('collapsed');
      }
    }
    
    // Toggle handler
    toggle.addEventListener('click', (e) => {
      e.preventDefault();
      const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isExpanded));
      submenu?.classList.toggle('collapsed');
      
      // Persist state
      localStorage.setItem(`category-${category}`, !isExpanded ? 'expanded' : 'collapsed');
    });
  });
</script>
