---
import { SEO } from "astro-seo";
import TopNav from "../components/TopNav.astro";
import { UIPortalInpageNav } from "../components/ui-portal-inpage-nav.js";
import ThemeInit from '../components/ThemeInit.astro';
import LionWordmark from '../components/LionWordmark.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const site = Astro.site || Astro.url.origin;
const canonicalURL = new URL(Astro.url.pathname, site).toString();
const resolvedImageWithDomain = new URL("/opengraph.jpg", site).toString();

interface Props {
  title: string;
  description?: string;
  headings?: Array<{ text?: string; slug?: string; name?: string; url?: string }>;
}

const {
  title,
  description = "Lion Blog",
  headings = [],
} = Astro.props;

// Transform headings to proper format for UIPortalInpageNav
const transformedHeadings = headings.map(h => ({
  name: h.name || h.text || '',
  url: h.url || h.slug || '',
})).filter(h => h.name && h.url);
---

<style>
  /*
   * The article reads lede-first, the way the Wired story does: the cover runs the full container
   * width at the top, then a kicker, a display headline, a bold standfirst and a hairline, and only
   * after that does the page split into the text column and the in-page nav.
   *
   * The lede block itself is styled in src/pages/blog/[...path].astro, next to the markup it belongs
   * to - Astro scopes a style block to the elements its own component renders, and slotted content
   * does not carry the layout's scope attribute, so rules for it cannot live here. What is left here
   * is the page frame the header used to be nested inside of: the header sat in the 800px reading
   * column, which is why the cover could never be wider than the text it illustrates.
   */
  .container.flex {
    flex-direction: column;
    align-items: stretch;
  }

  .blog-detail-layout {
    display: grid;
    grid-template-columns: minmax(0, 800px) 280px;
    gap: 3rem;
    align-items: start;
    width: 100%;
  }

  .blog-detail-content {
    grid-column: 1;
    min-width: 0;
  }

  .blog-detail-toc {
    grid-column: 2;
    position: sticky;
    top: 100px;
    height: fit-content;
    max-height: calc(100vh - 120px);
    overflow-y: auto;
    border-left: 2px solid var(--blog-accent);
    padding-left: 1.5rem;
  }

  @media (max-width: 1200px) {
    .blog-detail-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .blog-detail-toc {
      display: none;
    }
  }

  @media (max-width: 700px) {
    /* A 2:1 cover on a 390px viewport is a 195px band - too thin to read as a lede, so the phone
     * gets 16:9 and the title is free to run the full measure. */
    .blog-lede__cover {
      aspect-ratio: 16 / 9;
      margin-bottom: 1.5rem;
    }

    .blog-lede h1 {
      max-width: none;
    }

    .blog-lede__meta {
      margin-bottom: 1.75rem;
    }
  }
</style>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="view-transition" content="same-origin" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light dark" />
    <ThemeInit />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href=`${base}/favicon.svg` />
    <meta name="generator" content={Astro.generator} />

    <link rel="stylesheet" href={`${base}/styles/theme.css`} />
    <link rel="stylesheet" href=`${base}/styles/styles.css`>
    <link rel="stylesheet" href=`${base}/styles/components.css`>
    <link rel="stylesheet" href=`${base}/styles/blog.css`>
    <link rel="stylesheet" href=`${base}/styles/transitions.css`>
    <link rel="stylesheet" href=`${base}/styles/scroll-animations.css`>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

    <script src="@webcomponents/scoped-custom-element-registry/scoped-custom-element-registry.min.js"></script>

    <SEO
      title={title}
      description={description}
      canonical={canonicalURL}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: "website",
          title: title,
          image: resolvedImageWithDomain,
        },
        image: {
          alt: title,
        },
      }}
    />
</head>
<body class="blog-page">
    <div class="scroll-progress"></div>

    <TopNav activeNavItem="blog" variant="l1-blog" />

    <main>
        <div class="container flex">
            <div class="blog-lede" data-pagefind-body>
                <slot name="header" />
            </div>

            <div class="blog-detail-layout">
                <div class="blog-detail-content" data-pagefind-body>
                    <article class="blog-article">
                        <slot />
                    </article>
                </div>

                <aside class="blog-detail-toc">
                    <UIPortalInpageNav navData={transformedHeadings} client:load />
                </aside>
            </div>
        </div>
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="footer-row">
                <div class="footer-brand">
                    <LionWordmark />
                    <p class="copyright">&copy; {new Date().getFullYear()} Lion Project. MIT License.</p>
                </div>
                <div class="footer-links">
                    <a href=`${base}/blog/`>Blog</a>
                    <a href="https://github.com/ing-bank/lion/issues">Help</a>
                    <a href="https://github.com/ing-bank/lion">GitHub</a>
                    <a href=`/prev/about/slack/`>Slack</a>
                    <a href="https://github.com/ing-bank/lion/blob/master/CONTRIBUTING.md">Contribute</a>
                </div>
            </div>
        </div>
    </footer>
</body>
</html>
