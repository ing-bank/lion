---
import { getCollection } from "astro:content";
// import { UIPortalMainNav } from './ui-portal-main-nav.js';
import { UIMainNav as UIPortalMainNav } from './UIMainNav/ui-main-nav.js';

import SearchModal from './SearchModal.astro';
import LionWordmark from '../components/LionWordmark.astro';

interface Props {
  variant?: string;
}

async function buildCollectionTree(collectionName, filter) {
  const entries = await getCollection(collectionName, filter);
  const entriesSortedByLevel = entries
    .map((entry) => {
      const level = entry.id.split('/').length;
      return { ...entry, level };
    })
    .sort((a, b) => a.level - b.level);
  const navigationMap = { children: [] };

  for (const entry of entriesSortedByLevel) {
    if (entry.id === 'index' || entry.id.endsWith('/index')) {
      // Skip index pages, as they are represented as folders
      continue;
    }

    navigationMap[entry.id] = { entry, children: [] };
    const parentUrl = entry.id.split('/').slice(0, -1).join('/');
    if (navigationMap[parentUrl]) {
      navigationMap[parentUrl].children.push(navigationMap[entry.id]);
    } else {
      navigationMap.children.push(navigationMap[entry.id]);
    }

  }

  return navigationMap.children;
}

function convertCollectionTreeToNavigation(collectionTree, baseUrl = '/', isSortedAlphabetically = true) {
  const navigation = [];
  collectionTree.forEach((collectionNode) => {
    const { entry, children } = collectionNode;
    const navigationNode = {
      name: entry.data?.eleventyNavigation?.title || entry.id,
      url: [baseUrl, entry.id].join('/'),
      priority: entry.data?.eleventyNavigation?.order || 0,
    };

    if (children.length > 0) {
      navigationNode.children = convertCollectionTreeToNavigation(children, baseUrl, false);
    }

    navigation.push(navigationNode);
  });

  if (isSortedAlphabetically) {
    navigation.sort((a, b) => a.name.localeCompare(b.name));
  } else {
    // Sort child items by priority
    navigation.sort((a, b) => a.priority - b.priority);
  }

  // if page has a child, we sent to the first child
  // this preserves the logic of the previous implementation
  // see @rocket/navigation@0.2.1 /src/RocketNavigation.js
  navigation.forEach((navigationNode) => {
    if (navigationNode.children?.length > 0) {
      navigationNode.redirect = navigationNode.children[0].redirect || navigationNode.children[0].url; // Set the URL to the first child's URL
    }
  });

  return navigation;
}

/**
 * The nav renders nested levels from `nextLevel` (see UIMainNav), and an item that has it is
 * expandable. The collection tree is deeper than a fly-out can carry - a components subtree alone is
 * a whole documentation tree - so the menu stops after a few levels.
 *
 * It used to stop one level earlier, which left real pages without a row: "Core" could not open
 * (its /overview, /slotmixin children were cut), so a page you can only reach through the menu was
 * not in the menu. Two levels below the top items now, which is what "all pages" needs - the deepest
 * rows are the leaf pages themselves.
 */
const MAX_DEPTH = 2;

function pruneDeeperThan(nodes, depth = 0) {
  for (const node of nodes) {
    if (!node.children?.length) continue;
    if (depth >= MAX_DEPTH) {
      delete node.children;
      continue;
    }
    pruneDeeperThan(node.children, depth + 1);
  }

  return nodes;
}

const slug = value =>
  value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');

/**
 * `children` is what the server side uses to mark the active trail; `nextLevel` is what the
 * component renders and what makes an item a toggle. The key keeps the popover ids unique - one
 * level 2 panel per parent, and a popovertarget can only address one id.
 */
function toNavLevels(items, { topLevelLinksUnderneath = true } = {}) {
  return items.map(item => {
    const children = item.children || [];
    const node = { ...item };
    delete node.children;

    /*
     * A sub-section's own page is an empty shell: /fundamentals/systems renders a heading and no
     * content (measured: 943 characters of inline CSS and no prose, against 3970 characters on
     * /fundamentals/systems/core/overview), because the collection puts the content on the first
     * child. `redirect` from the collection tree is exactly that first child, so a row that has a
     * level links to it and the link lands on a page with something on it.
     *
     * Only below the top level: /fundamentals, /guides and /blog are real pages of their own. It
     * applies to a row whether or not it has a level of its own - "Systems" (a folder) and "Core" (a
     * leaf in the pruned tree, but its collection node still knows its first child) both land on a page
     * with content this way.
     */
    if (!topLevelLinksUnderneath && item.redirect) {
      node.url = item.redirect;
    }

    if (children.length) {
      node.nextLevel = {
        key: slug(item.name),
        // Nested levels are disclosures: they expand *downward* inside the fly-out instead of
        // opening another full-height panel. Level 1 is the panel (the component opens it with
        // mode 'popover'); its children are inline.
        items: toNavLevels(children, { topLevelLinksUnderneath: false }),
      };

      /*
       * A top-level row is a toggle, not a link: the section's own page moves into the level as its
       * first entry ("overview"), so the link is one tap away - underneath, where the menu is read.
       * It is done here, at build time, and not in the mobile layout's processor: a transformation
       * that only runs on the client gives the same item two different shapes in the server and the
       * client render, and the parts that differ get new elements on hydration - which is what left
       * the level toggles bound to elements that were no longer in the document.
       *
       * The desktop processor takes the link back (its rows are flat links), and `overview: true` is
       * what marks the entry it moved.
       */
      if (topLevelLinksUnderneath && node.url) {
        node.nextLevel.items = [
          { name: 'overview', url: node.url, overview: true },
          ...node.nextLevel.items,
        ];
        delete node.url;
      }
    }
    return node;
  });
}

async function getNavigation(collectionName, baseUrl = '/', isSortedAlphabetically = true, filter = () => true) {
  const collectionTree = await buildCollectionTree(collectionName, filter);
  const navigation = convertCollectionTreeToNavigation(collectionTree, baseUrl, isSortedAlphabetically);

  return pruneDeeperThan(navigation);
}

const components = await getNavigation(
  "lionComponents",
  `${import.meta.env.BASE_URL}/components`
);
const fundamentals = await getNavigation(
  "lionFundamentals",
  `${import.meta.env.BASE_URL}/fundamentals`,
  false
);
const guides = await getNavigation(
  "lionGuides",
  `${import.meta.env.BASE_URL}/guides`,
  false
);
const blogEntries = await getNavigation(
  "lionBlog",
  `${import.meta.env.BASE_URL}/blog`,
  false,
  entry => entry.data?.published
);

/**
 * @typedef {{name: string; url: string; active?:boolean; hasActiveChild?: boolean; iconId?: string; children?: NavItemData[]}} NavItem
 */

 /** @type {NavItem[]} */
const navData = [
  // {
  //   name: "home",
  //   url: import.meta.env.BASE_URL,
  //   iconId: 'lion-portal:portal:home'
  // },
  {
    name: "fundamentals",
    url: `${import.meta.env.BASE_URL}/fundamentals`,
    children: fundamentals,
  },
  {
    name: "guides",
    url: `${import.meta.env.BASE_URL}/guides`,
    children: guides,
  },
  {
    name: "components",
    url: `${import.meta.env.BASE_URL}/components`,
    children: components,
  },
  {
    name: "blog",
    url: `${import.meta.env.BASE_URL}/blog`,
    children: blogEntries,
  },
];

// Add search and github to navData
navData.push(
  {
    name: 'Search',
    // url: '/search',
    iconId: 'lion:portal:search',
    command: 'open-search',
  },
  {
    name: 'GitHub',
    url: 'https://github.com/ing-bank/lion',
    iconId: 'lion:portal:github',
    target: '_blank',
    rel: 'noopener noreferrer',
  }
);

/** @type WeakMap<{NavItem},{NavItem}> */
const itemParents = new WeakMap();

function _setParentsActive(navItem) {
  const parentItem = itemParents.get(navItem);
  if (parentItem) {
    parentItem.hasActiveChild = true;
    _setParentsActive(parentItem);
  }
}

function setParents(navData, parentItem = null) {
  for (const navItem of navData) {
    if (parentItem) {
      itemParents.set(navItem, parentItem);
    }
    if (navItem.children?.length) {
      setParents(navItem.children, navItem);
    }
  }
}

let activeItem;
function setActive(navData, currentUrl) {
  // for home page we need to check with the exact match
  const isActive = (navItem) => {
    if (navItem.url === import.meta.env.BASE_URL) {
      // homepage
      return `${navItem.url}/` === currentUrl;
    }

    // /components/form
    // /components/form-input problem
    return `${currentUrl}/`.startsWith(`${navItem.url}/`);
  }

  for (const navItem of navData) {
    if (isActive(navItem)) {
      navItem.active = true;
      activeItem = navItem;
    }
    if (navItem.children?.length) {
      setActive(navItem.children, currentUrl);
    }
  }
}

setParents(navData);
setActive(navData, Astro.url.pathname);
_setParentsActive(activeItem);

const { variant } = Astro.props;
---

<style>
  .site-header {
    /* Was `background: var(--background-primary)` - a token that exists nowhere in the project, so
     * the bar computed to rgba(0,0,0,0): a pure backdrop-filter with no scrim behind it, which is
     * what made it look smudgy. The themed scrim from styles.css is the intended surface. */
    background: var(--header-bg);
    border-bottom: 1px solid var(--header-border, var(--border-color, #e2e8f0));
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: inherit;
    flex-shrink: 0;
    flex-grow: 0;
  }

  .logo:hover {
    text-decoration: none;
  }

  .logo-text-svg {
    /* Removed grayscale filter to keep logo intact */
  }

  :global(.site-header ui-portal-main-nav) {
    flex: 1;
    height: auto;
  }

</style>

<header class="site-header">
    <div class="container">
        <a href=`${import.meta.env.BASE_URL}` class="logo" aria-label="Lion">
            <LionWordmark />
        </a>
        
        <div class="site-nav">
          <UIPortalMainNav 
            client:load 
            nav-data={JSON.stringify({ items: toNavLevels(navData) })} 
            variant={variant || ''}
          />
        </div>

        <!--
          Theme switch. CSS only: the radios set `color-scheme` on :root via :has(), which is the
          only thing light-dark() in styles.css reads. No JavaScript and no stored preference, so
          "Auto" has to be a real option in the group - a reset button could not be checked, which
          left the default state with nothing selected and made the control appear/disappear as
          you used it (see public/styles/theme.css).
        -->
        <form class="theme-switch" aria-label="Colour theme">
            <input type="radio" name="theme" id="theme-light" value="light" />
            <label for="theme-light" title="Light theme"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="12" cy="12" r="4.2" fill="currentColor"/><g stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M12 2.4v2.6M12 19v2.6M2.4 12h2.6M19 12h2.6M5.2 5.2l1.9 1.9M16.9 16.9l1.9 1.9M18.8 5.2l-1.9 1.9M7.1 16.9l-1.9 1.9"/></g></svg></label>
            <input type="radio" name="theme" id="theme-dark" value="dark" />
            <label for="theme-dark" title="Dark theme"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M20.5 14.6A8.5 8.5 0 1 1 9.4 3.5a7 7 0 0 0 11.1 11.1Z" fill="currentColor"/></svg></label>
            <input type="radio" name="theme" id="theme-auto" value="auto" checked />
            <label for="theme-auto" title="Follow the system theme">Auto</label>
        </form>
    </div>
</header>

<script>
  // Listen for 'open-search' command from UIPortalMainNav
  const setupSearchListener = () => {
    const navElement = document.querySelector('ui-main-nav');

    if (navElement) {
      navElement.addEventListener('open-search', () => {
        // Dispatch custom event that SearchModal listens for
        document.dispatchEvent(new CustomEvent('search-requested'));
      });
    } else {
      // Retry if nav element not found yet
      setTimeout(setupSearchListener, 100);
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupSearchListener);
  } else {
    setupSearchListener();
  }
</script>

<SearchModal />