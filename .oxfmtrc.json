{
  "printWidth": 100,
  "singleQuote": true,
  "arrowParens": "avoid",
  "trailingComma": "all",
  "sortPackageJson": false,
  "ignorePatterns": [
    "coverage/**",
    "CHANGELOG.md",
    "bundlesize/**",
    "_site/**",
    "_site-dev/**",
    ".history/**",
    "_demos/**",
    "docs/_assets/scoped-custom-element-registry.min.js",
    "docs/_assets/scoped-custom-element-registry.min.js.map",
    "docs/_merged_data/**",
    "docs/_merged_assets/**",
    "docs/_merged_includes/**",
    "packages/ui/_legacy-changelogs/**",
    "packages/ui/generated/**",
    "packages-node/awesome-phonenumber/upstream/**",
    "packages-node/awesome-phonenumber/build/**",
    "packages-node/awesome-phonenumber/dist/**",
    "prev-portal/**",
    "portal/**"
  ]
}
