registry=https://registry.npmjs.org

# pnpm is the installer for this repo (see pnpm-workspace.yaml).
# - link-workspace-packages: workspace members are linked as real directories, so the checkout is what runs
#   (npm resolves `*` ranges against the registry instead).
link-workspace-packages=true

# A flat root node_modules, like npm's: the docs examples and astro resolve bare imports
# (`lit-element` from docs/**/node_modules/page-a/page-a.js, @lit-labs/ssr-client from astro's injected
# script) that no project declares. The workspace members the docs import (@lion/ui, @lion/ajax,
# singleton-manager) are declared as root dependencies, so a direct dependency wins over the hoisted copy -
# measured without that: the published @lion/ui@0.15.5 was hoisted to node_modules/@lion/ui and shadowed the
# local library.
public-hoist-pattern[]=*
