{
  "private": true,
  "name": "@lion/root",
  "license": "MIT",
  "scripts": {
    "build": "npm --prefix portal run build",
    "changeset": "changeset",
    "custom-elements-manifest": "npm run custom-elements-manifest --workspaces --if-present && node ./scripts/create-api-tables.mjs",
    "debug": "web-test-runner --watch --config web-test-runner-chrome.config.mjs",
    "debug:firefox": "web-test-runner --watch --config web-test-runner-firefox.config.mjs",
    "debug:no-scoped-registries-polyfill": "npm run debug -- --no-scoped-registries-polyfill",
    "debug:webkit": "web-test-runner --watch --config web-test-runner-webkit.config.mjs",
    "deploy": "gh-pages -d _site -a -r git@github.com:ing-bank/lion --nojekyll",
    "format": "npm run format:eslint && npm run format:prettier && npm run format:oxfmt",
    "format:eslint": "eslint --ext .js,.html . --fix",
    "format:oxfmt": "oxfmt \"**/*.{js,md}\" \"packages/*/package.json\"",
    "format:prettier": "prettier \"**/*.{js,md,astro}\" \"packages/*/package.json\" \"package.json\" --write",
    "lint": "wireit",
    "lint:eslint": "eslint --ext .js,.html .",
    "lint:markdownlint": "git ls-files '*.md' | xargs markdownlint --ignore '{.github/**/*.md,.changeset/*.md,**/CHANGELOG.md,packages/ui/_legacy-changelogs/*.md,packages-node/awesome-phonenumber/upstream/**,prev-portal/*.md,portal/*.md}'",
    "lint:oxfmt": "oxfmt --check \"**/*.{js,md}\" \"packages/*/package.json\"",
    "lint:phone-number-up-to-date": "node ./scripts/lint-phone-number-lib.js",
    "lint:prettier": "prettier \"**/*.js\" --list-different || (echo '\u2191\u2191 these files are not prettier formatted \u2191\u2191' && exit 1)",
    "lint:types": "npm run types",
    "lint:versions": "node ./scripts/lint-versions.js",
    "oxlint:check": "oxlint --config .oxlintrc.json --ignore-path .eslintignore .",
    "postinstall": "npx patch-package && npm run build:phone --workspace @lion/ui && npm run custom-elements-manifest",
    "predeploy": "npm run build",
    "prepare": "husky install",
    "preview": "npx serve _site",
    "release": "changeset publish",
    "repo:clean-slate": "git clean -dfX",
    "repo:diff-package-lock": "npx diff-package-lock",
    "repo:lockfile:check": "npm run lockfile:check --workspace @lion/lockfile-interop",
    "repo:lockfile:generate": "npm run lockfile:generate --workspace @lion/lockfile-interop",
    "screenshots-comparison:generate-screenshots-diff": "node ./scripts/screenshots-comparison/generate-screenshots-diff.js --target-branch master",
    "screenshots-comparison:update-baseline": "node ./scripts/screenshots-comparison/update-baseline.js --target-branch master",
    "start:prod": "npm run preview",
    "temporary-disabled__lint:types": "npm run types",
    "test": "wireit",
    "test:browser": "web-test-runner --coverage",
    "test:node": "npm run test:node --workspaces --if-present",
    "types": "npm run types --workspaces --if-present",
    "types-check-only": "npm run types-check-only --workspaces --if-present"
  },
  "workspaces": [
    "packages/*",
    "packages-node/*",
    "test/typescript-legacy"
  ],
  "dependencies": {
    "@playwright/test": "^1.61.0",
    "lit": "^3.3.3",
    "playwright": "^1.61.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@bundled-es-modules/fetch-mock": "^6.5.2",
    "@changesets/cli": "^2.30.0",
    "@custom-elements-manifest/analyzer": "^0.10.10",
    "@custom-elements-manifest/to-markdown": "^0.1.0",
    "@lit-labs/ssr": "4.1.0",
    "@lit-labs/testing": "^0.2.8",
    "@lit/reactive-element": "^2.1.2",
    "@mdjs/core": "^0.21.1",
    "@open-wc/dedupe-mixin": "^2.0.1",
    "@open-wc/eslint-config": "^12.0.3",
    "@open-wc/scoped-elements": "^3.0.5",
    "@open-wc/testing": "^4.0.0",
    "@open-wc/testing-helpers": "^3.0.1",
    "@thepassle/module-graph": "^0.11.0",
    "@types/autosize": "^4.0.3",
    "@types/chai-as-promised": "^8.0.1",
    "@types/chai-dom": "^1.11.3",
    "@types/fs-extra": "^11.0.4",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.9",
    "@web/test-runner": "^0.19.0",
    "@web/test-runner-commands": "^0.9.0",
    "@web/test-runner-playwright": "^0.11.0",
    "@web/test-runner-visual-regression": "^0.10.0",
    "@webcomponents/scoped-custom-element-registry": "^0.0.10",
    "@webcomponents/template-shadowroot": "^0.2.1",
    "cem-plugin-vs-code-custom-data-generator": "^1.4.2",
    "chai": "^4.5.0",
    "chai-as-promised": "^8.0.0",
    "cross-env": "^7.0.3",
    "custom-element-jet-brains-integration": "^1.8.0",
    "es-module-lexer": "^1.7.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-wc": "^2.2.0",
    "gh-pages": "^6.3.0",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "markdownlint-cli": "^0.49.1",
    "mocha": "^10.7.3",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^3.3.3",
    "prettier-package-json": "^2.8.0",
    "providence-analytics": "^0.21.0",
    "remark-html": "^13.0.2",
    "rocket-preset-extend-lion-docs": "^0.4.0",
    "semver": "^7.6.3",
    "sinon": "^19.0.2",
    "typescript": "^7.0.2",
    "unist-util-visit": "^5.0.0",
    "wireit": "^0.14.13"
  },
  "comments": {
    "overrides": {
      "//": [
        "For best compatibility, we sometimes need to override a package version depended upon by multiple packages."
      ],
      "//@open-wc/semantic-dom-diff": [
        "Transitive dep of @open-wc/testing. 0.20.1 ships chai-dom-diff-plugin.d.ts with an extensionless",
        "relative import (TS2835 under --moduleResolution nodenext); 0.21.0 emits the .js extension."
      ],
      "lit, lit-element, lit-html, @lit/reactive-element": [
        "The workspace installed lit several times over: the root 3.x plus 2.8.0 copies inside the legacy",
        "@lion/* packages that arrived through @rocket/*. Which copy an Astro island's module graph resolved",
        "varied per page load, and the injected @lit-labs/ssr-client hydration support patches exactly one",
        "LitElement - so on some loads an island rendered a second copy of its template beside the",
        "server-rendered shadow root instead of hydrating it (a duplicated table of contents, 3 of 6 page",
        "loads). The portal and @lion/ui run the single 3.3.3 copy."
      ],
      "//@open-wc/dedupe-mixin": [
        "Declared at the root on purpose: it used to arrive hoisted through the legacy rocket dependency tree,",
        "while src/components/shared/UIBaseElement.js and LightRenderMixin.js import it by name."
      ],
      "@web/test-runner-commands": [
        "@lit-labs/testing asks for ^0.6.1 while the root depends on ^0.9.0, so npm nested a second copy (0.6.6)",
        "that dragged an entire old @web/test-runner stack in: @web/test-runner-core@0.10.29 ->",
        "@web/dev-server-core@0.4.1 -> ip@1.1.9 (GHSA-2p57-rm9w-gvfp, high). The only api the ssr fixtures use",
        "is executeServerCommand, which is unchanged, so one override dedupes it: -10 lock entries, ip gone."
      ]
    },
    "olderVersions": {
      "//": [
        "Our aim is to keep all depencies up-to-date(for maintainability, performance and security).",
        "We use [npm-outdated](https://marketplace.visualstudio.com/items?itemName=mskelton.npm-outdated) as a helper for this.",
        "Sometimes we can't bc/o incompatibility issues."
      ],
      "eslint": [
        "Can't be updated yet to 9.x, because of eslint-plugin-import"
      ],
      "typescript": [
        "Since changes in types can be reflected in the code, we want to keep this stable for a longer period of time.",
        "As semver is not followed, we keep our major versions aligned with a minot of TS (hence '~' instead of '^' is used)"
      ],
      "remark-html": [
        "Can't be updated to 14.x, because remark-html is still in commonjs."
      ],
      "chai": [
        "Can't be updated to 5.x, because @web/dev-server-core test-helpers (having implicit dep on chai) is not compatible with chai >= 5.x"
      ]
    },
    "toBeRemoved": {
      "//": [
        "For maintainability, performance and security, we want to keep the number of dependencies as low as possible (in case functionality can be achieved via existing dependencies or platform functionality)."
      ],
      "@bundled-es-modules/fetch-mock": [
        "Can be achieved via sinon as well"
      ],
      "publish-docs/fs-extra | @types/fs-extra": [
        "Copy can be achieved via node's fs module"
      ],
      "@lit/reactive-element": [
        "We make sure latest version is hoisted and resolved, until we move to astro (when we can regenerate the package-lock.json file w/o breaking Rocket)."
      ]
    }
  },
  "dependenciesAstroForTheFuture": {
    "@astrojs/lit": "^4.3.0",
    "@astrojs/mdx": "^4.0.8",
    "@mdjs/core": "^0.21.1",
    "@mdjs/mdjs-preview": "^0.6.0",
    "@mdjs/mdjs-story": "^0.4.0",
    "@open-wc/scoped-elements": "^3.0.5",
    "@webcomponents/scoped-custom-element-registry": "^0.0.10",
    "@webcomponents/template-shadowroot": "^0.2.1",
    "astro": "^5.3.0",
    "astro-pagefind": "^1.8.3",
    "astro-seo": "^0.7.5",
    "es-module-lexer": "^1.7.0",
    "lit": "^3.2.1",
    "rocket-preset-extend-lion-docs": "^0.4.0",
    "unist-util-visit": "^5.0.0"
  },
  "imports": {
    "#components/*": "packages/ui/components/*"
  },
  "overrides": {
    "@open-wc/semantic-dom-diff": "^0.21.0",
    "@mdjs/core": "^0.21.1",
    "@mdjs/mdjs-story": "^0.4.0",
    "remark-rehype": "^8",
    "@mdjs/mdjs-preview": {
      ".": "^0.6.0",
      "@lion/ui": "^0.15.0"
    },
    "pug-code-gen": "3.0.3",
    "astro": "^6.0.8",
    "@lit-labs/ssr": "4.1.0",
    "@lit-labs/ssr-client": "1.1.8",
    "@lit-labs/ssr-dom-shim": "1.6.0",
    "lit": "$lit",
    "lit-element": "4.2.2",
    "lit-html": "3.3.3",
    "@lit/reactive-element": "$@lit/reactive-element",
    "@lion/listbox": {
      "lit": "2.8.0",
      "lit-element": "3.3.3",
      "lit-html": "2.8.0",
      "@lit/reactive-element": "1.6.3"
    },
    "@lion/overlays": {
      "lit": "2.8.0",
      "lit-element": "3.3.3",
      "lit-html": "2.8.0",
      "@lit/reactive-element": "1.6.3"
    },
    "@web/test-runner-commands": "^0.9.0"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "arrowParens": "avoid",
    "trailingComma": "all"
  },
  "wireit": {
    "lint": {
      "dependencies": [
        "lint:eslint",
        "lint:markdownlint",
        "lint:oxfmt",
        "lint:phone-number-up-to-date",
        "lint:prettier",
        "lint:types",
        "lint:versions"
      ]
    },
    "test": {
      "dependencies": [
        "test:browser",
        "test:node"
      ]
    }
  }
}
