{
  "name": "eslint-plugin-lion",
  "version": "0.0.0",
  "private": true,
  "description": "Oxlint JS plugins for the Lion monorepo",
  "license": "MIT",
  "author": "ing-bank",
  "homepage": "https://github.com/ing-bank/lion/",
  "repository": {
    "type": "git",
    "url": "https://github.com/ing-bank/lion.git",
    "directory": "packages-node/eslint-plugin-lion"
  },
  "exports": {
    ".": "./index.js",
    "./compat/lit-a11y": "./compat/lit-a11y.js",
    "./compat/wc": "./compat/wc.js"
  },
  "main": "index.js",
  "files": [
    "*.js",
    "compat/*.js"
  ],
  "keywords": [
    "oxlint",
    "lint"
  ],
  "dependencies": {
    "eslint-plugin-lit-a11y": "^4.1.4",
    "eslint-plugin-wc": "^2.2.0",
    "oxc-resolver": "^1.12.0"
  },
  "scripts": {
    "test": "npm run test:node",
    "test:node": "node --test test-node/*.test.js"
  }
}
