#!/bin/sh
# The lock external tooling reads has to describe what pnpm installs (packages-node/lockfile-interop):
# a dependency added or updated with pnpm and never mirrored into package-lock.json is exactly the drift
# that otherwise reaches main, where it surfaces later as a version decision on a package the app does
# not load. CI runs the same checks, this is just the earlier copy.
npm run repo:workspace:check || {
  echo ''
  echo "pnpm-workspace.yaml is not what package.json implies."
  echo "Fix it with:  npm run repo:workspace:sync"
  exit 1
}
npm run repo:lockfile:check || {
  echo ''
  echo "package-lock.json is out of sync with what pnpm installs."
  echo "Mirror it with:  npm run repo:lockfile:sync"
  echo "then commit package.json + package-lock.json (pnpm-lock.yaml is gitignored)."
  exit 1
}
npm run lint:workspace-lists
